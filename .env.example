# LabForge Environment Configuration

MONGODB_URI=mongodb://127.0.0.1:27017/labforge
MONGODB_DB_NAME=labforge
PORT=8081

VITE_APP_NAME="LabForge"
VITE_APP_VERSION="1.2.0"
VITE_MODE="offline"

# AI Service Configuration (Google Gemini)
VITE_AI_SERVICE_ENABLED=true
VITE_AI_PROVIDER="gemini"
GEMINI_API_KEY=your_gemini_api_key_here

# Local Lab Runner Services Configuration
VITE_MONGODB_RUNNER_PORT=27017
VITE_JUPYTER_RUNNER_PORT=8888
VITE_CPP_COMPILER="g++"

# Electron Container Settings
ELECTRON_SECURE_MODE=true

